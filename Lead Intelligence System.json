    {
      "parameters": {
        "jsCode": "// \"Message a model\" node returns content at this exact path\nconst rawText = $input.item.json.content.parts[0].text;\n\n// Clean in case Gemini adds markdown despite instructions\nconst cleanedText = rawText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Parse the JSON\nlet parsed;\ntry {\n  parsed = JSON.parse(cleanedText);\n} catch(e) {\n  // Fallback if JSON parse fails\n  const leadFallback = $('Code in JavaScript1').item.json;\n  return {\n    json: {\n      ...leadFallback,\n      parse_error: true,\n      subject: 'Follow up from AI Automation Specialist',\n      body: 'Hi ' + leadFallback.first_name + ', I came across your business and wanted to reach out about how AI automation could help streamline your operations. Would you be open to a quick 15 minute call?',\n      pain_point_identified: 'Could not parse',\n      personalization_hook: 'Could not parse'\n    }\n  };\n}\n\n// Pull lead fields from Code in JavaScript1 node\nconst leadData = $('Code in JavaScript1').item.json;\n\nreturn {\n  json: {\n    lead_id:                leadData.lead_id,\n    first_name:             leadData.first_name,\n    last_name:              leadData.last_name,\n    company_name:           leadData.company_name,\n    website_url:            leadData.website_url,\n    industry:               leadData.industry,\n    email:                  leadData.email,\n    subject:                parsed.subject,\n    body:                   parsed.body,\n    pain_point_identified:  parsed.pain_point_identified,\n    personalization_hook:   parsed.personalization_hook,\n    parse_error:            false\n  }\n};"
      },
