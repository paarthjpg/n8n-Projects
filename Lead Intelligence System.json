    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fields = $input.item.json.body.data.fields;\n\nfunction getField(labelName) {\n  return fields.find(\n    f => f.label && f.label.trim().toLowerCase() === labelName.trim().toLowerCase()\n  ) || null;\n}\n\nfunction getValue(field) {\n  if (!field || field.value === null || field.value === undefined) return '';\n\n  const type = field.type;\n\n  if (\n    type === 'INPUT_TEXT' ||\n    type === 'INPUT_EMAIL' ||\n    type === 'INPUT_PHONE_NUMBER' ||\n    type === 'INPUT_NUMBER' ||\n    type === 'TEXTAREA' ||\n    type === 'INPUT_DATE' ||\n    type === 'INPUT_TIME'\n  ) {\n    return String(field.value).trim();\n  }\n\n  if (type === 'INPUT_LINK') {\n    let url = String(field.value).trim();\n    if (url && !url.startsWith('http://') && !url.startsWith('https://')) {\n      url = 'https://' + url;\n    }\n    return url;\n  }\n\n  if (type === 'DROPDOWN' || type === 'MULTIPLE_CHOICE' || type === 'MULTI_SELECT') {\n    const selectedIds = Array.isArray(field.value) ? field.value : [field.value];\n    const options = field.options || [];\n    const matched = options\n      .filter(opt => selectedIds.includes(opt.id))\n      .map(opt => opt.text);\n    return matched.join(', ');\n  }\n\n  return String(field.value).trim();\n}\n\nconst leadId = Date.now().toString() + Math.floor(Math.random() * 1000).toString();\n\nreturn {\n  json: {\n    lead_id:       leadId,\n    first_name:    getValue(getField('First Name')),\n    last_name:     getValue(getField('Last Name')),\n    company_name:  getValue(getField('Company Name')),\n    website_url:   getValue(getField('Website URL')),\n    industry:      getValue(getField('Industry')),\n    email:         getValue(getField('Email Address')),\n    status:        '',\n    contacted_at:  '',\n    email_subject: '',\n    email_body:    '',\n    submitted_at:  new Date().toISOString()\n  }\n};"
      },
