    {
      "parameters": {
        "jsCode": "// Get website HTML from HTTP Request node (current input)\nconst htmlContent = $input.item.json.data || \n                    $input.item.json.body || \n                    $input.item.json || '';\n\nconst rawHtml = typeof htmlContent === 'string' \n  ? htmlContent \n  : JSON.stringify(htmlContent);\n\n// Clean the HTML\nlet cleaned = rawHtml.replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '');\ncleaned = cleaned.replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '');\ncleaned = cleaned.replace(/<[^>]+>/g, ' ');\ncleaned = cleaned.replace(/\\s+/g, ' ').trim();\ncleaned = cleaned.substring(0, 3000);\n\n// Pull lead fields from Get row(s) in sheet node\n// This node has your lead data — reference it by its exact node name\nconst leadData = $('Get row(s) in sheet').item.json;\n\nreturn {\n  json: {\n    lead_id:       leadData.lead_id,\n    first_name:    leadData.first_name,\n    last_name:     leadData.last_name,\n    company_name:  leadData.company_name,\n    website_url:   leadData.website_url,\n    industry:      leadData.industry,\n    email:         leadData.email,\n    website_text:  cleaned\n  }\n};"
      },
